<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutli zaxira va yangi telefonga ko‘chirishda ma’lumotlar bazasi saqlanadi. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
